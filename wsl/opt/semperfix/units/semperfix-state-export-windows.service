[Unit]
Description=Phoenix v2.1 Passive State Export
After=network.target

[Service]
Type=oneshot
ExecStart=/opt/semperfix/scripts/state-export-windows.sh
User=root
Group=semperfix
UMask=002
StandardOutput=append:/opt/semperfix/logs/export.log
StandardError=append:/opt/semperfix/logs/export.log

[Install]
WantedBy=multi-user.target
