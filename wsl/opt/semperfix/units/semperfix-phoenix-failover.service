[Unit]
Description=Phoenix Failover Evaluator
After=semperfix-phoenix-status-write.service

[Service]
Type=oneshot
UMask=002
ExecStart=/opt/semperfix/scripts/phoenix-failover.sh
User=root
Group=semperfix
TimeoutStartSec=30
StandardOutput=append:/opt/semperfix/logs/failover.log
StandardError=append:/opt/semperfix/logs/failover.log

[Install]
WantedBy=multi-user.target