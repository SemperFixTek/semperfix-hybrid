[Unit]
Description=Phoenix Mesh Handshake
After=semperfix-phoenix-supervisor.service semperfix-network-normalizer.service

[Service]
Type=oneshot
UMask=002
ExecStart=/opt/semperfix/scripts/mesh-handshake.sh
User=root
Group=semperfix
StandardOutput=append:/opt/semperfix/logs/handshake.log
StandardError=append:/opt/semperfix/logs/handshake.log

[Install]
WantedBy=multi-user.target
