[Unit]
Description=SemperFix Phoenix v2.1 Passive Heartbeat
Wants=network-online.target
After=network-online.target

[Service]
UMask=002
Type=oneshot
ExecStart=/opt/semperfix/scripts/wsl-phoenix-heartbeat.sh
User=root
Group=semperfix
StandardOutput=append:/opt/semperfix/logs/heartbeat.log
StandardError=append:/opt/semperfix/logs/heartbeat.log

[Install]
WantedBy=multi-user.target