[Unit]
Description=Phoenix Promotion Evaluation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

UMask=002

User=root
Group=semperfix

WorkingDirectory=/opt/semperfix

ExecStart=/opt/semperfix/scripts/phoenix-promote.sh

Nice=5

TimeoutStartSec=60

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target