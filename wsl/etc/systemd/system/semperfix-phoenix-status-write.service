[Unit]
Description=Phoenix Status Writer
After=network-online.target

[Service]
Type=oneshot

UMask=002

User=root
Group=semperfix

WorkingDirectory=/opt/semperfix

ExecStart=/opt/semperfix/scripts/phoenix-status-write.sh

Nice=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target