[Unit]
Description=Secondary State Export service

[Service]
Type=oneshot
UMask=002
ExecStart=/opt/semperfix/scripts/state-export.sh
User=root
Group=semperfix
StandardOutput=append:/opt/semperfix/logs/export.log
StandardError=append:/opt/semperfix/logs/export.log

[Install]
WantedBy=multi-user.target
