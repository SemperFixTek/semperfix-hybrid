[Unit]
Description=Phoenix v2.1 Passive Mesh Status

[Service]
Type=oneshot
UMask=002
ExecStart=/opt/semperfix/scripts/wsl-mesh-status.sh
User=root
Group=semperfix
StandardOutput=append:/opt/semperfix/logs/status.log
StandardError=append:/opt/semperfix/logs/status.log

[Install]
WantedBy=multi-user.target
