[Unit]
Description=Copy SECONDARY state JSON into Windows NTFS
After=network.target

[Service]
Type=oneshot
ExecStart=/opt/semperfix/scripts/state-export-windows.sh
User=root
Group=semperfix
UMask=002
StandardOutput=append:/opt/semperfix/logs/export-windows.log
StandardError=append:/opt/semperfix/logs/export-windows.log

[Install]
WantedBy=multi-user.target
