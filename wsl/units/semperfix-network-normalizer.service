[Unit]
Description=Phoenix v2.1 Network Normalizer
After=network-online.target
Wants=network-online.target
Before=semperfix-supervisor.service

[Service]
Type=oneshot
UMask=002
ExecStart=/opt/semperfix/scripts/linux-normalizer.sh
User=root
Group=semperfix
StandardOutput=append:/opt/semperfix/logs/network-normalizer.log
StandardError=append:/opt/semperfix/logs/network-normalizer.log

[Install]
WantedBy=multi-user.target
