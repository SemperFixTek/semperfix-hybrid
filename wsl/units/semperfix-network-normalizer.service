# /opt/semperfix/units/semperfix-network-normalizer.service 

[Unit] 
Description=SemperFix WSL2 Network Normalizer 
After=network-online.target 
Before=semperfix-supervisor.service  

[Service]
Umask=002
Type=oneshot 
User=root
Group=semperfix
ExecStart=/opt/semperfix/scripts/linux-normalizer.sh 
RemainAfterExit=yes 
StandardOutput=append:/opt/semperfix/logs/network.log 
StandardError=append:/opt/semperfix/logs/network.log  

[Install] 
WantedBy=semperfix.target