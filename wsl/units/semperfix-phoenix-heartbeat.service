[Unit]
Description=SemperFix Phoenix v2 Heartbeat
Documentation=/opt/semperfix/docs/phoenix-heartbeat.md
Wants=network-online.target
After=network-online.target

[Service]
Umask=002
Type=oneshot
ExecStart=/opt/semperfix/scripts/wsl-phoenix-heartbeat.sh
User=root
Group=semperfix
StandardOutput=append:/opt/semperfix/logs/heartbeat.log
StandardError=append:/opt/semperfix/logs/heartbeat.log

ExecStartPre=/usr/bin/flock -n /opt/semperfix/state/.heartbeat.lock -c true

[Install]
WantedBy=semperfix.target
